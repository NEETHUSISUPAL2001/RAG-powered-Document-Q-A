# ============================================
# DocuMind AI — Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ── JWT Authentication ─────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=super-secret-key-please-change-in-production

TOKEN_EXPIRE_HOURS=168  # 7 days default

# ── MongoDB Connection ──────────────────────
MONGO_URI=mongodb://localhost:27017/documind_ai?readPreference=primary&retryWrites=true&w=majority

# ── ChromaDB (optional — for local testing) ─
CHROMA_PATH=./chroma_db

# ── Groq LLM API ────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# ── Frontend (optional — for deployment) ────
VITE_API_BASE_URL=http://127.0.0.1:8000