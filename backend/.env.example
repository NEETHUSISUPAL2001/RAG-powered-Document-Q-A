# ============================================
# DocuMind AI — Backend Environment Configuration
# Copy this file to .env and fill in your real values
# ============================================

# ── JWT Authentication ─────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-strong-random-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── MongoDB Connection ──────────────────────
MONGO_URI=mongodb://localhost:27017/documind_ai
# DB_NAME=rag_db

# ── ChromaDB ────────────────────────────────
CHROMA_PATH=./chroma_db

# ── Groq LLM API ────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL_NAME=llama-3.1-8b-instant

# ── Environment ─────────────────────────────
ENVIRONMENT=development

# ── Google OAuth ────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://rag-project-backend-vf1f.onrender.com/auth/google/callback

# ── Frontend / Deployment ──────────────────
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
